NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Leave both EMPTY until you have the real values (owner batch 7, A2). The code refuses
# placeholder-shaped values (G-XXXXXXXXXX / your-gsc-verification-token): analytics never
# loads and no google-site-verification meta is emitted. Setting the example text as a
# real value used to look like "GA configured" while pointing at a property that does not exist.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFY=
REVALIDATE_TOKEN=your-secret-revalidate-token
