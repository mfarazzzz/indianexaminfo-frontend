# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Playwright e2e artifacts (local evidence only, never versioned)
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# tsc/build scratch output - never commit (see repo hygiene rule). Root-level only.
tsc-*.txt
tc-done.txt
/*.log

# QA screenshot drop (local evidence only, not versioned)
qa/screenshots/

# Playwright session state (npm run cms:login lives in the CMS repo; this repo
# only ever shoots public pages, but .auth/ is ignored here too so a stray
# storageState can never be committed)
.auth/

# typescript
*.tsbuildinfo
next-env.d.ts
